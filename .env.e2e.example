# Copy to .env.e2e (never commit .env.e2e).
# Browser/e2e tests load ONLY this file and refuse live Stripe keys / prod DB hosts.

E2E_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/elysium_e2e
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/elysium_e2e

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=e2e-nextauth-secret-min-32-characters-long

STRIPE_SECRET_KEY=sk_test_e2e_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_e2e_placeholder

CRON_SECRET=e2e-cron-secret
TMC_REVIEW_PASSCODE=e2e-tmc-passcode
TMC_REVIEW_ALLOWED_EMAILS=client@example.test
