# App Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Database (local Postgres for migrate/seed; never point wipe/seed scripts at prod Supabase)
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:5432/elysium
POSTGRES_PRISMA_URL=postgresql://postgres:postgres@127.0.0.1:5432/elysium
POSTGRES_URL_NON_POOLING=postgresql://postgres:postgres@127.0.0.1:5432/elysium
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/elysium

# Tests that touch the database MUST set this. There is no fallback to DATABASE_URL.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/elysium_test

# Extra hosts allowed for migrate/seed/test (comma-separated). Supabase hosts are never allowed.
# ALLOWED_TEST_DB_HOSTS=postgres.test

# Demo admin + DISABLE_ADMIN_AUTH are ignored when NODE_ENV or VERCEL_ENV is production.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DISABLE_ADMIN_AUTH=false

# Authentication (NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TMC review access (client + admin). At least one of:
# 1) TMC_REVIEW_PASSCODE — shared passcode, issued as an httpOnly cookie
# 2) A User with role=ADMIN (pnpm db:create-admin)
# 3) TMC_REVIEW_ALLOWED_EMAILS — comma-separated NextAuth emails
TMC_REVIEW_PASSCODE=
TMC_REVIEW_ALLOWED_EMAILS=
# TMC_REVIEW_COOKIE_SECRET=   # optional; falls back to NEXTAUTH_SECRET

# Stripe (never put sk_live / pk_live in .env.e2e)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
ADMIN_NOTIFICATION_EMAIL=

# TMC review → notify when client taps "Add to ELYSIUM"
# Cursor Automations: create a Webhook trigger, paste the URL + API key here.
TMC_REVIEW_WEBHOOK_URL=
TMC_REVIEW_WEBHOOK_API_KEY=
# Alias also accepted:
# CURSOR_AUTOMATION_WEBHOOK_URL=

# Cron/scheduled API routes fail closed without this Bearer secret.
# Vercel Cron sends Authorization: Bearer ${CRON_SECRET}.
CRON_SECRET=

# Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional
CONTEXT7_API_KEY=

# Explicit override to run seed scripts when NODE_ENV/VERCEL_ENV is production
# (still blocked against Supabase hosts). Leave unset.
# ALLOW_PRODUCTION_SEED=true
