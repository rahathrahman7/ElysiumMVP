# App Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Database (Vercel Postgres)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
DATABASE_URL=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DISABLE_ADMIN_AUTH=false

# Authentication (NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
ADMIN_NOTIFICATION_EMAIL=

# Cursor Automations — TMC Plan webhook (optional)
# Create the automation at https://cursor.com/automations/new (webhook trigger),
# then paste the URL + API key here / in Vercel env so /api/tmc-review can fire it.
CURSOR_TMC_AUTOMATION_WEBHOOK_URL=
CURSOR_TMC_AUTOMATION_WEBHOOK_API_KEY=

# Analytics
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional
CONTEXT7_API_KEY=
